# R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rl-ssp-centering

# R2 Cloudflare API Token
R2_TOKEN_VALUE=

# Runpod
RUNPOD_API_KEY=

# RunPod container-registry credential id (removes Docker Hub anonymous pull limits).
# Create: runpodctl registry create --name dockerhub --username <user>   then paste the id here.
RUNPOD_REGISTRY_AUTH_ID=
